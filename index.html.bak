const TAG_LABEL = {system:'System', update:'Update', notice:'Notice'};
function renderAnnouncements(){
  const wrap = document.getElementById('announce-list');
  if(!announcements.length){
    wrap.innerHTML = `<div style="font-size:12px;color:var(--gray-400);padding:8px 0">お知らせはありません</div>`;
    return;
  }
  wrap.innerHTML = announcements.map(a=>`
    <div class="announce-item">
      <div><span class="announce-tag tag-${a.tag}">${TAG_LABEL[a.tag]||a.tag}</span> <span class="announce-date">${escapeHTML(a.date)}</span></div>
      <div class="announce-title">${escapeHTML(a.title)}</div>
      <div class="announce-desc">${escapeHTML(a.desc)}</div>
    </div>
  `).join('');
}

/* ═══════════════════════════════════════════════════
   🗞️ バナーニュース（ITmedia AI＋ のRSSを表示）
   ─────────────────────────────────────────────────
   ・AI関連ニュースメディア「ITmedia AI＋」の新着RSSを、
     rss2json という無料の中継サービス経由で取得しています
     （多くのニュースサイトはブラウザから直接取得できないため）
   ・取得に失敗した場合は自動的に「ITmedia AI＋を見る」
     というリンク表示に切り替わります
   ・表示件数や切り替え間隔は下の変数で調整できます
   ・他のニュース源に変えたい場合は AI_NEWS_RSS_URL のURLを
     差し替えるだけでOKです
   ・表示させたくない記事がある場合は、少し下にある
     NEWS_BLOCKLIST にキーワードを追加してください
     （タイトル・本文・URLにそのキーワードを含む記事は
     自動的に非表示になります）
═══════════════════════════════════════════════════ */

const AI_NEWS_RSS_URL = 'https://rss.itmedia.co.jp/rss/2.0/aiplus.xml';
const RSS2JSON_ENDPOINT = 'https://api.rss2json.com/v1/api.json?rss_url=';
const NEWS_ROTATE_INTERVAL = 6000; // ニュース切り替え間隔（ミリ秒）
let newsItems = [];
let newsIndex = 0;
let newsRotateTimer = null;

/* ─────────────────────────────────────────────────
   表示させたくないニュースを除外するフィルター
   タイトル・本文・リンクURLに以下のキーワードが
   含まれる記事は自動的に非表示にします
   ───────────────────────────────────────────────── */
const NEWS_BLOCKLIST = [
  'FANZA', 'DMM.R18', 'アダルト', 'AV女優', 'アイドル水着',
];
function isBlockedNewsItem(item){
  const text = `${item.title||''} ${item.description||''} ${item.link||''}`;
  return NEWS_BLOCKLIST.some(word => text.includes(word));
}

async function fetchAiNews(){
  const textEl = document.getElementById('banner-news-text');
  try{
    const res = await fetch(RSS2JSON_ENDPOINT + encodeURIComponent(AI_NEWS_RSS_URL));
    const data = await res.json();
    if(data.status !== 'ok' || !data.items || !data.items.length){
      throw new Error('no items');
    }
    newsItems = data.items.filter(item => !isBlockedNewsItem(item)).slice(0, 8);
    if(!newsItems.length){
      throw new Error('all items blocked');
    }
    // 「開くたびに1件目から」を避けるため、現在時刻をもとに
    // 表示開始位置を決める（NEWS_ROTATE_INTERVALの周期で進む）
    const elapsedSlots = Math.floor(Date.now() / NEWS_ROTATE_INTERVAL);
    newsIndex = elapsedSlots % newsItems.length;
    showNewsItem();
    if(newsRotateTimer) clearInterval(newsRotateTimer);
    newsRotateTimer = setInterval(()=>{
      newsIndex = (newsIndex + 1) % newsItems.length;
      showNewsItem();
    }, NEWS_ROTATE_INTERVAL);
  }catch(e){
    textEl.innerHTML = `<a href="https://www.itmedia.co.jp/aiplus/" target="_blank" rel="noopener">ITmedia AI＋ で最新ニュースを見る ↗</a>`;
  }
}
function showNewsItem(){
  const textEl = document.getElementById('banner-news-text');
  if(!newsItems.length) return;
  const item = newsItems[newsIndex];
  textEl.innerHTML = `<a href="${item.link}" target="_blank" rel="noopener">${escapeHTML(item.title)}</a>`;
}

/* ═══════════════════════════════════════════════════
   💡 今日の豆知識（60個を日替わりローテーション）
   ─────────────────────────────────────────────────
   ・日付をもとに毎日1つ表示します
   ・60個を順番にローテーションし、同じ日は同じ豆知識です
═══════════════════════════════════════════════════ */

const triviaList = [
  '日本で最も多い名字は「佐藤」とされています。',
  '富士山の標高は3,776メートルです。',
  '日本の国土のおよそ3分の2は森林です。',
  '1円玉1枚の重さは1グラムです。',
  '郵便番号は1998年に現在の7桁になりました。',
  '日本の信号機では、緑色を「青信号」と呼びます。',
  'ペンギンは鳥ですが、空を飛ぶ代わりに泳ぐことへ適応しました。',
  'タコの心臓は3つあります。',
  'キリンの首の骨の数は人間と同じ7個です。',
  'イルカは眠るとき、脳の左右を交代で休ませます。',
  'ハチミツは水分が少なく酸性のため、非常に腐りにくい食品です。',
  'バナナは植物学上「ベリー（液果）」の一種に分類されます。',
  'イチゴの赤い部分は、植物学上の「果実」ではありません。',
  'ピーナッツはナッツではなく、豆の仲間です。',
  'トマトは植物学では果実、料理では野菜として扱われます。',
  'レモンには、ビタミンC以外にもクエン酸が多く含まれています。',
  'コーヒー豆は、コーヒーノキの実の種です。',
  'チョコレートの原料カカオは、木になる果実の種から作られます。',
  '炭酸飲料の泡の正体は二酸化炭素です。',
  '氷は水より密度が低いため、水に浮きます。',
  '水は約4℃のときに最も密度が高くなります。',
  '雷の光は音よりずっと速く届くため、稲光の後に雷鳴が聞こえます。',
  '虹は一般に外側が赤、内側が紫に見えます。',
  '雲は、小さな水滴や氷の粒の集まりです。',
  '宇宙空間では音を伝える空気がないため、音はそのまま伝わりません。',
  '月は自ら光っているのではなく、太陽の光を反射して輝いています。',
  '地球は約24時間で1回自転します。',
  '地球が太陽の周りを1周するのは約365.24日です。',
  '太陽の光が地球に届くまで約8分20秒かかります。',
  '金星は、太陽系の惑星の中でも特に高温です。',
  '人間の体の骨は、成人では通常206個です。',
  '人間の体で最も大きな臓器は皮膚です。',
  '人間の心臓は、安静時でも1日におよそ10万回拍動します。',
  '左右の肺は同じ大きさではなく、一般に右肺のほうが大きいです。',
  'まばたきは、目の表面を涙で潤す役割があります。',
  '指紋の模様は、一人ひとり異なります。',
  'くしゃみのとき目を閉じるのは反射的な動きです。',
  '爪は一般に、足より手のほうが速く伸びます。',
  '睡眠中も脳は完全に止まらず、さまざまな活動を続けています。',
  '笑うときには、顔の多くの筋肉が協調して動きます。',
  '紙は何度も折ると急激に厚くなるため、同じ方向に何十回も折るのは困難です。',
  'A4用紙の縦横比は1対√2です。',
  '鉛筆の芯には鉛ではなく、主に黒鉛と粘土が使われています。',
  '消しゴムは、紙から黒鉛をこすり取って字を消します。',
  'ボールペンの先端には、小さな球が入っています。',
  'QRコードの「QR」はQuick Responseの略です。',
  'USBの「U」はUniversalの頭文字です。',
  'Wi-Fiという名称は、技術規格名そのものの略語ではありません。',
  'Webページの「URL」はUniform Resource Locatorの略です。',
  'キーボードのFとJには、指の位置を確認するための突起があります。',
  '一般的なパソコンの2進数では、1バイトは8ビットです。',
  'デジタル画像は、小さな点「ピクセル」の集まりで表現されます。',
  '電子メールの「@」は、英語でat signと呼ばれます。',
  'Bluetoothの名称は、10世紀のデンマーク王ハーラル1世の異名に由来します。',
  '「ロボット」という言葉は、チェコ語の「労働」を意味する語に由来します。',
  '世界初期のコンピューター用マウスは木製でした。',
  '検索エンジンは、Web上の情報を収集・整理して検索結果を返します。',
  'パスワードは、長さを増やすほど総当たり攻撃への耐性が高まりやすくなります。',
  '同じパスワードの使い回しは、1件の漏えいが他サービスにも波及する原因になります。',
  'ソフトウェア更新には、新機能だけでなくセキュリティ修正が含まれることがあります。'
];
function getTodaysTrivia(){
  const now = new Date();
  const start = new Date(now.getFullYear(),0,1);
  const dayOfYear = Math.floor((now - start) / 86400000);
  return triviaList[dayOfYear % triviaList.length];
}
function showTodaysTrivia(){
  document.getElementById('banner-dajare-text').textContent = getTodaysTrivia();
}

/* ═══════════════════ サイドバー：ホバーでサブメニュー表示 ═══════════════════ */
let hideFlyoutTimer = null;


function renderSidebarNav(){
  const wrap = document.getElementById('sidebar-cat-list');
  wrap.innerHTML = categories.map(c=>`
    <div class="nav-item-wrap" onmouseenter="showFlyout(this,'${c.id}')" onmouseleave="scheduleHideFlyout()">
      <div class="nav-item" onclick="openCategoryModal('${c.id}')">
        <span class="nav-icon">${c.icon}</span><span class="nav-text">${c.name}</span>
      </div>
    </div>
  `).join('');
}

function showFlyout(wrapEl, catId){
  cancelHideFlyout();
  const c = categories.find(x=>x.id===catId);
  if(!c) return;
  const validLinks = c.links.filter(l=>l.url && l.url!=='#');
  const flyoutBody = validLinks.length
    ? validLinks.map(l=>`
        <a class="nav-flyout-item" href="${l.url}" target="_blank" rel="noopener">
          <span>${escapeHTML(l.name)}</span>
          <span class="nav-flyout-arrow">↗</span>
        </a>
      `).join('')
    : `<div class="nav-flyout-empty">まだリンクがありません</div>`;

  const flyout = document.getElementById('shared-flyout');
  flyout.innerHTML = `<div class="nav-flyout-hdr">${c.id} — ${c.name}</div>${flyoutBody}`;

  const rect = wrapEl.getBoundingClientRect();
  flyout.style.top = rect.top + 'px';
  flyout.style.left = (rect.right + 8) + 'px';
  flyout.classList.add('show');

  // 画面下にはみ出す場合は上に合わせて調整
  requestAnimationFrame(()=>{
    const fRect = flyout.getBoundingClientRect();
    if(fRect.bottom > window.innerHeight - 12){
      flyout.style.top = Math.max(12, window.innerHeight - fRect.height - 12) + 'px';
    }
  });
}
function scheduleHideFlyout(){
  hideFlyoutTimer = setTimeout(()=>{
    document.getElementById('shared-flyout').classList.remove('show');
  }, 180); // カーソルがフライアウトへ移動する時間を確保
}
function cancelHideFlyout(){
  if(hideFlyoutTimer){ clearTimeout(hideFlyoutTimer); hideFlyoutTimer = null; }
}

/* ═══════════════════ 初期化 ═══════════════════ */
function renderBrowseGrid(){
  const grid=document.getElementById('browse-grid');
  const top=categories.slice(0,4);
  grid.innerHTML = top.map(c=>`
    <div class="cat-browse-card" onclick="openCategoryModal('${c.id}')">
      <div class="cat-browse-icon" style="background:${c.bg};color:${c.color}">${c.icon}</div>
      <div class="cat-browse-name">${c.name}</div>
      <div class="cat-browse-count">${c.links.length}</div>
    </div>
  `).join('') + `
    <div class="cat-browse-card" onclick="openAllCategoryPicker()">
      <div class="cat-browse-icon" style="background:#f8fafc;color:#64748b">⋯</div>
      <div class="cat-browse-name">もっと見る</div>
      <div class="cat-browse-count">${categories.slice(4).reduce((a,c)=>a+c.links.length,0)}</div>
    </div>
  `;
}

const THUMB_GRADIENTS = ['linear-gradient(135deg,#93c5fd,#3b82f6)','linear-gradient(135deg,#86efac,#10b981)','linear-gradient(135deg,#f9a8d4,#ec4899)','linear-gradient(135deg,#fdba74,#f97316)','linear-gradient(135deg,#c4b5fd,#8b5cf6)'];

/* ═══════════════════ よく使うツール（表示専用・5枠固定） ═══════════════════ */
const FT_GRADIENTS = ['linear-gradient(135deg,#93c5fd,#3b82f6)','linear-gradient(135deg,#86efac,#10b981)','linear-gradient(135deg,#f9a8d4,#ec4899)','linear-gradient(135deg,#fdba74,#f97316)','linear-gradient(135deg,#c4b5fd,#8b5cf6)'];
/* ═══════════════════════════════════════════════════
   ⭐ よく使うツール（表示専用・5枠固定）
   ─────────────────────────────────────────────────
   ・ユーザー側での編集はできません（表示のみ）
   ・ツールを設定する場合は、下の DEFAULT_FT 配列を直接編集してください
     name（表示名）・url（リンク先）・icon（絵文字1つ）の3項目です
   ・空欄のままにすると「整備中」表示になります
   ・例：
     { name:'○○フォーム', url:'https://...', icon:'📝' },
═══════════════════════════════════════════════════ */

const DEFAULT_FT = [
  { name:'日時報告', url:'https://docs.google.com/forms/d/e/1FAIpQLSe8eYu8jZJs3goSR2nxmx5PVyHkF7RmsjUIn9jLpug17cIcIg/viewform?pli=1', icon:'📅' },
  { name:'行動管理', url:'https://script.google.com/a/macros/pcdepot.jp/s/AKfycbxPT5Sv5RTgOoCPM831f-8IGpqUirdNOePj4wI5grUpPHE2eNCbUfG9cBOT7x6iqfOS/exec', icon:'📝' },
  { name:'AO校ダッシュボード', url:'https://script.google.com/a/macros/pcdepot.jp/s/AKfycbzfmgHu47y3I2bxzgOOFW7n77E4JOWLcwNC59BORcl13o-xR5nUVMqQFDbQRmbOy5hEng/exec', icon:'📊' },
  { name:'', url:'', icon:'' },
  { name:'', url:'', icon:'' },
];
function renderFeatured(){
  const grid=document.getElementById('featured-grid');
  grid.innerHTML = DEFAULT_FT.map((t,i)=>{
    const isEmpty = !t.url;
    if(isEmpty){
      return `
      <div class="ft-slot">
        <div class="ft-slot-thumb" style="background:var(--gray-50);color:var(--gray-300)">➕</div>
        <div class="ft-slot-body">
          <div class="ft-slot-name" style="color:var(--gray-400)">未設定</div>
          <div class="ft-slot-badge">整備中</div>
        </div>
      </div>`;
    }
    return `
    <a class="ft-slot filled" href="${t.url}" target="_blank" rel="noopener">
      <div class="ft-slot-thumb" style="background:${FT_GRADIENTS[i%5]};color:#fff">${t.icon||'🔗'}</div>
      <div class="ft-slot-body">
        <div class="ft-slot-name">${escapeHTML(t.name)}</div>
      </div>
    </a>`;
  }).join('');
}

/* ═══════════════════ カテゴリ詳細モーダル ═══════════════════ */
function openCategoryModal(id){
  const c = categories.find(x=>x.id===id);
  if(!c) return;
  document.getElementById('cat-modal-icon').style.background = c.bg;
  document.getElementById('cat-modal-icon').style.color = c.color;
  document.getElementById('cat-modal-icon').textContent = c.icon;
  document.getElementById('cat-modal-name').textContent = `${c.id} — ${c.name}`;
  document.getElementById('cat-modal-sub').textContent = c.sub;
  document.getElementById('cat-modal-body').innerHTML = c.links.map(l=>`
    <a class="cat-modal-lk" href="${l.url}" ${l.url!=='#'?'target="_blank" rel="noopener"':''}>
      <div><div class="cat-modal-lk-name">${l.name}</div><div class="cat-modal-lk-dom">${l.dom}</div></div>
      <div class="cat-modal-lk-arrow">↗</div>
    </a>
  `).join('');
  document.getElementById('cat-modal-overlay').classList.add('open');
  closeMobileMenu();
}
function closeCategoryModal(){
  document.getElementById('cat-modal-overlay').classList.remove('open');
}
function openAllCategoryPicker(){
  document.getElementById('cat-modal-icon').style.background = 'var(--gray-100)';
  document.getElementById('cat-modal-icon').style.color = 'var(--gray-600)';
  document.getElementById('cat-modal-icon').textContent = '📂';
  document.getElementById('cat-modal-name').textContent = '全カテゴリ';
  document.getElementById('cat-modal-sub').textContent = 'すべてのカテゴリから選ぶ';
  document.getElementById('cat-modal-body').innerHTML = categories.map(c=>`
    <a class="cat-modal-lk" href="#" onclick="openCategoryModal('${c.id}');return false;">
      <div style="display:flex;align-items:center;gap:10px">
        <div style="width:30px;height:30px;border-radius:8px;display:grid;place-items:center;background:${c.bg};color:${c.color};font-size:14px;flex-shrink:0">${c.icon}</div>
        <div><div class="cat-modal-lk-name">${c.id} — ${c.name}</div><div class="cat-modal-lk-dom">${c.links.length} Links</div></div>
      </div>
      <div class="cat-modal-lk-arrow">›</div>
    </a>
  `).join('');
  document.getElementById('cat-modal-overlay').classList.add('open');
  closeMobileMenu();
}
/* Escape handled globally below */

/* ═══════════════════ ショートカット（LocalStorage） ═══════════════════ */
const SC_KEY = 'mishima_portal_shortcuts';

const DEFAULT_SHORTCUTS = [
  {name:'Google Meet', sub:'日次確認', url:'https://meet.google.com/vgq-xrnv-hkw?pli=1', icon:'📹'},
  {name:'ジョブカン', sub:'勤怠管理', url:'https://id.jobcan.jp/users/sign_in', icon:'☁️'},
  {name:'日次報告', sub:'Forms', url:'https://docs.google.com/forms/d/e/1FAIpQLSe8eYu8jZJs3goSR2nxmx5PVyHkF7RmsjUIn9jLpug17cIcIg/viewform?pli=1', icon:'📝'},
  {name:'Claude', sub:'AI', url:'https://claude.ai/', icon:'🤖'},
];
let shortcuts = [];

function loadShortcuts(){
  try{
    const saved = localStorage.getItem(SC_KEY);
    shortcuts = saved ? JSON.parse(saved) : [...DEFAULT_SHORTCUTS];
  }catch(e){ shortcuts = [...DEFAULT_SHORTCUTS]; }
  renderShortcuts();
}
function saveShortcuts(){
  try{ localStorage.setItem(SC_KEY, JSON.stringify(shortcuts)); }catch(e){}
}
function renderShortcuts(){
  const wrap = document.getElementById('shortcut-items');
  wrap.innerHTML = shortcuts.map((s,i)=>`
    <a class="shortcut-item" href="${s.url}" target="_blank" rel="noopener">
      <span class="ic">${s.icon||'📌'}</span>
      <span>${s.name}${s.sub?`<span class="sub">${s.sub}</span>`:''}</span>
      <span class="shortcut-rm" onclick="event.preventDefault();event.stopPropagation();removeShortcut(${i})">✕</span>
    </a>
  `).join('');
}
function removeShortcut(i){
  shortcuts.splice(i,1);
  saveShortcuts();
  renderShortcuts();
}
function openAddModal(){
  document.getElementById('modal-overlay').classList.add('open');
  showAddStep1();
}
function closeAddModal(){
  document.getElementById('modal-overlay').classList.remove('open');
}
function showAddStep1(){
  document.getElementById('add-modal-title').textContent = 'ショートカットを追加';
  document.getElementById('add-step1').style.display = 'block';
  document.getElementById('add-step2').style.display = 'none';
  const list = document.getElementById('add-cat-list');
  list.innerHTML = categories.map(c=>`
    <button class="add-pick-item" onclick="showAddStep2('${c.id}')">
      <div class="add-pick-icon" style="background:${c.bg};color:${c.color}">${c.icon}</div>
      <div><div class="add-pick-name">${c.id} — ${c.name}</div></div>
      <div class="add-pick-count">${c.links.length}件 ›</div>
    </button>
  `).join('');
}
function showAddStep2(catId){
  const c = categories.find(x=>x.id===catId);
  if(!c) return;
  document.getElementById('add-modal-title').textContent = 'ショートカットを追加';
  document.getElementById('add-step2-title').textContent = `${c.name} から選ぶ`;
  document.getElementById('add-step1').style.display = 'none';
  document.getElementById('add-step2').style.display = 'block';
  const list = document.getElementById('add-link-list');
  const validLinks = c.links.filter(l=>l.url && l.url!=='#');
  if(!validLinks.length){
    list.innerHTML = `<div style="font-size:12px;color:var(--gray-400);padding:12px 4px">このカテゴリにはまだリンクがありません</div>`;
    return;
  }
  list.innerHTML = validLinks.map(l=>`
    <button class="add-pick-item" onclick="addShortcutFromLink('${c.id}','${escapeHTML(l.name).replace(/'/g,"\\'")}')">
      <div class="add-pick-icon" style="background:${c.bg};color:${c.color}">${c.icon}</div>
      <div><div class="add-pick-name">${escapeHTML(l.name)}</div><div class="add-pick-dom">${escapeHTML(l.dom)}</div></div>
    </button>
  `).join('');
}
function addShortcutFromLink(catId, linkName){
  const c = categories.find(x=>x.id===catId);
  if(!c) return;
  const l = c.links.find(x=>x.name===linkName);
  if(!l) return;
  if(shortcuts.some(s=>s.url===l.url)){
    alert('このリンクはすでにショートカットに追加されています。');
    return;
  }
  shortcuts.push({name:l.name, sub:c.name, url:l.url, icon:c.icon});
  saveShortcuts();
  renderShortcuts();
  closeAddModal();
}

/* ═══════════════════ Quick Access（LocalStorage・4枠固定） ═══════════════════ */
const QA_KEY = 'mishima_portal_quick_access';
const QA_COLORS = [
  {bg:'#eff6ff',color:'#3b82f6'}, {bg:'#fdf2f8',color:'#ec4899'},
  {bg:'#f0fdf4',color:'#10b981'}, {bg:'#f5f3ff',color:'#8b5cf6'},
];

const DEFAULT_QA = [
  {name:'監査項目', url:'#', icon:'🛡️'},
  {name:'カレンダー', url:'#', icon:'📅'},
  {name:'日次報告', url:'https://docs.google.com/forms/d/e/1FAIpQLSe8eYu8jZJs3goSR2nxmx5PVyHkF7RmsjUIn9jLpug17cIcIg/viewform?pli=1', icon:'📝'},
  {name:'ジョブカン', url:'https://id.jobcan.jp/users/sign_in', icon:'☁️'},
];
let quickAccess = [];
let qaEditIndex = null;

function loadQuickAccess(){
  try{
    const saved = localStorage.getItem(QA_KEY);
    quickAccess = saved ? JSON.parse(saved) : [...DEFAULT_QA];
  }catch(e){ quickAccess = [...DEFAULT_QA]; }
  // 常に4枠を保証
  while(quickAccess.length < 4) quickAccess.push({name:'未設定', url:'', icon:'➕'});
  quickAccess = quickAccess.slice(0,4);
  renderQuickAccess();
}
function saveQuickAccess(){
  try{ localStorage.setItem(QA_KEY, JSON.stringify(quickAccess)); }catch(e){}
}
function renderQuickAccess(){
  const grid = document.getElementById('quick-grid');
  grid.innerHTML = quickAccess.map((q,i)=>{
    const col = QA_COLORS[i%4];
    const isEmpty = !q.url;
    const href = isEmpty ? '#' : q.url;
    return `
    <a class="quick-card" href="${href}" ${!isEmpty?'target="_blank" rel="noopener"':''} onclick="${isEmpty?`openQaModal(${i});return false;`:''}">
      <div class="quick-edit-btn" onclick="event.preventDefault();event.stopPropagation();openQaModal(${i})">✏️</div>
      <div class="quick-icon" style="background:${col.bg};color:${col.color}">${q.icon||'📌'}</div>
      <div class="quick-name">${isEmpty?'タップして設定':escapeHTML(q.name)}</div>
    </a>`;
  }).join('');
}
function openQaModal(i){
  qaEditIndex = i;
  const q = quickAccess[i];
  document.getElementById('qa-name').value = (q && !isDefaultEmpty(q)) ? q.name : '';
  document.getElementById('qa-url').value = (q && !isDefaultEmpty(q)) ? q.url : '';
  document.getElementById('qa-icon').value = (q && !isDefaultEmpty(q)) ? q.icon : '';
  document.getElementById('qa-modal-overlay').classList.add('open');
  document.getElementById('qa-modal-overlay').dataset.target='quickaccess';
}
function isDefaultEmpty(q){ return !q.url; }
function closeQaModal(){
  document.getElementById('qa-modal-overlay').classList.remove('open');
  qaEditIndex = null;
}
function saveQaCard(){
  const name = document.getElementById('qa-name').value.trim();
  const url = document.getElementById('qa-url').value.trim();
  const icon = document.getElementById('qa-icon').value.trim() || '📌';
  if(!name || !url){ alert('タイトルとURLは必須です。'); return; }
  if(qaEditIndex===null) return;
  quickAccess[qaEditIndex] = {name, url, icon};
  saveQuickAccess();
  renderQuickAccess();
  closeQaModal();
}

/* ═══════════════════ 検索 ═══════════════════ */
function getAllLinksFlat(){
  const all = [];
  categories.forEach(c=>{
    c.links.forEach(l=>{
      all.push({...l, catId:c.id, catName:c.name, catColor:c.color, catBg:c.bg});
    });
  });
  return all;
}
function renderSearchResults(query){
  const panel = document.getElementById('search-results-panel');
  const q = query.trim().toLowerCase();
  if(!q){ panel.classList.remove('open'); panel.innerHTML=''; return; }
  const matches = getAllLinksFlat().filter(l => l.name.toLowerCase().includes(q));
  if(!matches.length){
    panel.innerHTML = `<div class="sr-empty">「${escapeHTML(query)}」に一致するリンクが見つかりません</div>`;
  }else{
    panel.innerHTML = matches.slice(0,15).map(l=>`
      <a class="sr-item" href="${l.url}" ${l.url!=='#'?'target="_blank" rel="noopener"':''}>
        <span class="sr-cat-badge" style="background:${l.catBg};color:${l.catColor}">${l.catName}</span>
        <span class="sr-name">${escapeHTML(l.name)}</span>
        <span style="color:var(--gray-300);font-size:13px">↗</span>
      </a>
    `).join('');
  }
  panel.classList.add('open');
}
function escapeHTML(str){
  const div=document.createElement('div');
  div.textContent=str;
  return div.innerHTML;
}
function doFind(){
  renderSearchResults(document.getElementById('find-search').value);
}
function quickSearch(term){
  document.getElementById('find-search').value = term;
  document.getElementById('global-search').value = term;
  doFind();
}
document.getElementById('global-search').addEventListener('input', function(){
  document.getElementById('find-search').value = this.value;
  renderSearchResults(this.value);
});
document.getElementById('find-search').addEventListener('input', function(){
  renderSearchResults(this.value);
});
document.getElementById('find-search').addEventListener('keydown', e=>{
  if(e.key==='Enter') doFind();
});
document.addEventListener('click', e=>{
  const panel = document.getElementById('search-results-panel');
  const findRow = document.querySelector('.find-input-row');
  if(findRow && !findRow.contains(e.target)){
    panel.classList.remove('open');
  }
});

/* ═══════════════════ ナビゲーション ═══════════════════ */
function scrollToTop(){ window.scrollTo({top:0, behavior:'smooth'}); }

/* ═══════════════════ モバイルメニュー ═══════════════════ */
const sidebar = document.getElementById('sidebar');
const overlay = document.getElementById('overlay');
function openMobileMenu(){ sidebar.classList.add('open'); overlay.classList.add('open'); }
function closeMobileMenu(){ sidebar.classList.remove('open'); overlay.classList.remove('open'); }
document.getElementById('burger-mobile').addEventListener('click', openMobileMenu);
document.getElementById('sidebar-close').addEventListener('click', closeMobileMenu);
overlay.addEventListener('click', closeMobileMenu);

/* ═══════════════════ 時計・天気 ═══════════════════ */
const WEEK=['日','月','火','水','木','金','土'];
function tick(){
  const n=new Date();
  const p=v=>String(v).padStart(2,'0');
  document.getElementById('tb-time').textContent=`${p(n.getHours())}:${p(n.getMinutes())}`;
  document.getElementById('tb-date').textContent=`${n.getFullYear()}.${p(n.getMonth()+1)}.${p(n.getDate())}(${WEEK[n.getDay()]})`;
}
tick();setInterval(tick,1000);

const WMO={0:'☀️',1:'🌤️',2:'⛅',3:'☁️',45:'🌫️',48:'🌫️',51:'🌦️',53:'🌦️',55:'🌧️',61:'🌧️',63:'🌧️',65:'🌧️',71:'🌨️',73:'🌨️',75:'🌨️',80:'🌦️',81:'🌧️',82:'🌧️',95:'⛈️',96:'⛈️',99:'⛈️'};
async function fetchWeather(){
  try{
    const res=await fetch('https://api.open-meteo.com/v1/forecast?latitude=35.1167&longitude=138.9167&current=temperature_2m,weathercode&timezone=Asia%2FTokyo');
    const data=await res.json();
    document.getElementById('tb-temp').textContent=`${Math.round(data.current.temperature_2m)}°C`;
    document.getElementById('tb-icon').textContent=WMO[data.current.weathercode]||'🌡️';
  }catch(e){}
}
fetchWeather();setInterval(fetchWeather,10*60*1000);

/* ═══════════════════ ロック画面 ═══════════════════ */
const PASS='mishima1124';
const SESSION_KEY='mishima_portal_auth';
const lockScreen=document.getElementById('lock-screen');
const lockInput=document.getElementById('lock-input');
const lockBtn=document.getElementById('lock-btn');
const lockError=document.getElementById('lock-error');
function unlock(){ lockScreen.classList.add('hidden'); sessionStorage.setItem(SESSION_KEY,'1'); }
function tryUnlock(){
  if(lockInput.value===PASS){ unlock(); }
  else{ lockError.classList.add('show'); lockInput.value=''; lockInput.focus(); setTimeout(()=>lockError.classList.remove('show'),2000); }
}
if(sessionStorage.getItem(SESSION_KEY)==='1'){ unlock(); }
lockBtn.addEventListener('click', tryUnlock);
lockInput.addEventListener('keydown', e=>{ if(e.key==='Enter') tryUnlock(); });
lockInput.focus();

/* ═══════════════════ 起動 ═══════════════════ */
renderSidebarNav();
renderBrowseGrid();
renderAnnouncements();
renderFeatured();
loadShortcuts();
loadQuickAccess();
fetchAiNews();
showTodaysTrivia();
loadTodos();
document.getElementById('todo-add-btn').addEventListener('click', addTodo);
document.getElementById('todo-input').addEventListener('keydown', e=>{ if(e.key==='Enter') addTodo(); });

/* ═══════════════════ ToDo（LocalStorage） ═══════════════════ */
const TODO_KEY = 'mishima_portal_todos';
let todos = [];
function loadTodos(){
  try{
    const saved = localStorage.getItem(TODO_KEY);
    todos = saved ? JSON.parse(saved) : [];
    if(!Array.isArray(todos)) todos = [];
  }catch(e){ todos = []; }
  renderTodos();
}
function saveTodos(){
  try{ localStorage.setItem(TODO_KEY, JSON.stringify(todos)); }catch(e){}
}
function renderTodos(){
  const list = document.getElementById('todo-list');
  if(!todos.length){
    list.innerHTML = '<div class="todo-empty">まだToDoはありません</div>';
    return;
  }
  list.innerHTML = todos.map((t,i)=>`
    <div class="todo-item${t.done?' done':''}">
      <div class="todo-check" onclick="toggleTodo(${i})" aria-label="完了切替">${t.done?'✓':''}</div>
      <div class="todo-text">${escapeHTML(t.text||'')}</div>
      <div class="todo-del" onclick="deleteTodo(${i})" title="削除">✕</div>
    </div>
  `).join('');
}
function addTodo(){
  const input = document.getElementById('todo-input');
  const text = (input.value||'').trim();
  if(!text) return;
  todos.unshift({text, done:false, id: Date.now()});
  input.value = '';
  saveTodos();
  renderTodos();
}
function toggleTodo(i){
  if(!todos[i]) return;
  todos[i].done = !todos[i].done;
  saveTodos();
  renderTodos();
}
function deleteTodo(i){
  todos.splice(i,1);
  saveTodos();
  renderTodos();
}

/* ═══════════════════ ⌘K / Ctrl+K・Escape・PWA ═══════════════════ */
document.addEventListener('keydown', e=>{
  if((e.metaKey||e.ctrlKey) && (e.key==='k'||e.key==='K')){
    e.preventDefault();
    const gs = document.getElementById('global-search');
    if(gs){ gs.focus(); gs.select(); }
  }
  if(e.key==='Escape'){
    closeCategoryModal();
    closeAddModal();
    closeQaModal();
  }
});

if('serviceWorker' in navigator){
  window.addEventListener('load', ()=>{
    navigator.serviceWorker.register('./sw.js').catch(()=>{});
  });
}
</script>
<div id="shared-flyout" onmouseenter="cancelHideFlyout()" onmouseleave="scheduleHideFlyout()"></div>
</body>
</html>
