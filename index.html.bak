<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,viewport-fit=cover"/>
<meta name="theme-color" content="#2f80ed"/>
<meta name="apple-mobile-web-app-capable" content="yes"/>
<meta name="apple-mobile-web-app-status-bar-style" content="default"/>
<meta name="apple-mobile-web-app-title" content="MISHIMA PORTAL"/>
<title>MISHIMA PORTAL</title>
<link rel="manifest" href="./manifest.webmanifest"/>
<link rel="icon" href="./icon.svg" type="image/svg+xml"/>
<link rel="apple-touch-icon" href="./icon.svg"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@900&family=Figtree:wght@400;500;600;700;800&family=Noto+Sans+JP:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
<style>
:root{
  --bg:#eef6ff;
  --surface:#ffffff;
  --ink:#1e293b;
  --muted:#64748b;
  --blue:#2f80ed;
  --blue-soft:#dbeafe;
  --yellow:#f5c518;
  --yellow-soft:#fff8db;
  --green:#10b981;
  --coral:#fb7185;
  --sidebar-w:220px;
  --border:rgba(47,128,237,.12);
  --shadow:0 4px 14px rgba(30,41,59,.06);
  --shadow-hover:0 10px 28px rgba(47,128,237,.12);
  --radius:14px;
  --gray-50:#f8fafc;
  --gray-100:#f1f5f9;
  --gray-200:#e2e8f0;
  --gray-300:#cbd5e1;
  --gray-400:#94a3b8;
  --gray-500:#64748b;
  --gray-600:#475569;
  --gray-900:#1e293b;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;overflow-x:hidden}
body{
  font-family:"Noto Sans JP","Figtree",system-ui,sans-serif;
  background:var(--bg);
  background-image:
    radial-gradient(ellipse 80% 50% at 10% -10%,rgba(47,128,237,.12),transparent),
    radial-gradient(ellipse 60% 40% at 100% 0%,rgba(245,197,24,.14),transparent),
    linear-gradient(180deg,#eef6ff 0%,#f5f9ff 40%,#eef4fb 100%);
  color:var(--ink);
  min-height:100vh;
  overflow-x:hidden;
  padding-top:env(safe-area-inset-top);
  font-size:14px;
  line-height:1.5;
}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer;border:none;background:none}
input{font-family:inherit}

.overlay{position:fixed;inset:0;background:rgba(30,41,59,.35);z-index:400;opacity:0;pointer-events:none;transition:opacity .25s;backdrop-filter:blur(2px)}
.overlay.open{opacity:1;pointer-events:all}

/* LOCK */
.lock{position:fixed;inset:0;z-index:9999;background:linear-gradient(160deg,#e8f2ff 0%,#fff9e6 50%,#eef6ff 100%);display:flex;align-items:center;justify-content:center;overflow:hidden}
.lock.hidden{display:none}
.lock-stripe{display:none}
.lock-inner{position:relative;z-index:2;text-align:center;padding:28px}
.lock-logo-txt{font-family:"Barlow Condensed",sans-serif;font-weight:900;line-height:.9;margin-bottom:28px}
.lock-logo-txt .fill{display:block;font-size:clamp(48px,12vw,88px);color:var(--blue);letter-spacing:.02em}
.lock-logo-txt .outline{display:block;font-size:clamp(40px,10vw,72px);color:var(--ink);letter-spacing:.02em}
.lock-logo-txt em{font-style:normal;color:var(--yellow)}
.lock-form{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:22px 24px;box-shadow:var(--shadow);max-width:360px;margin:0 auto}
.lock-label{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:10px;text-align:left}
.lock-input-wrap{display:flex;gap:8px}
.lock-input-wrap input{flex:1;border:1px solid var(--border);border-radius:10px;padding:10px 12px;font-size:14px;outline:none;background:#f8fbff}
.lock-input-wrap input:focus{border-color:var(--blue);box-shadow:0 0 0 3px var(--blue-soft)}
.lock-btn{background:var(--blue);color:#fff;border-radius:10px;padding:10px 16px;font-weight:600;font-size:13px;transition:transform .15s,box-shadow .15s}
.lock-btn:hover{transform:translateY(-1px);box-shadow:0 6px 16px rgba(47,128,237,.3)}
.lock-error{color:var(--coral);font-size:12px;margin-top:10px;opacity:0;transition:opacity .2s}
.lock-error.show{opacity:1}

.app{display:flex;min-height:100vh}

/* SIDEBAR */
.sidebar{
  width:var(--sidebar-w);flex-shrink:0;background:rgba(255,255,255,.88);
  border-right:1px solid var(--border);backdrop-filter:blur(12px);
  display:flex;flex-direction:column;position:fixed;top:0;left:0;bottom:0;z-index:300;
  padding:12px 10px;
}
.sidebar-logo{display:flex;align-items:center;gap:10px;padding:8px 8px 14px;border-bottom:1px solid var(--border);margin-bottom:8px}
.logo-icon{width:32px;height:32px;border-radius:10px;background:linear-gradient(135deg,var(--blue),#60a5fa);position:relative;box-shadow:0 4px 10px rgba(47,128,237,.25)}
.logo-icon:after{content:"";position:absolute;right:3px;bottom:3px;width:10px;height:10px;border-radius:3px;background:var(--yellow)}
.logo-text{font-weight:800;font-size:14px;letter-spacing:.02em;color:var(--ink)}
.logo-text .sub{display:block;font-size:10px;font-weight:600;color:var(--muted);letter-spacing:.12em}
.sidebar-close{display:none;margin-left:auto;font-size:16px;color:var(--muted);padding:4px}
.sidebar-nav{flex:1;overflow-y:auto;padding:4px 0}
.nav-label{font-size:10px;font-weight:700;color:var(--muted);letter-spacing:.1em;padding:10px 10px 6px;text-transform:uppercase}
.nav-item{display:flex;align-items:center;gap:8px;padding:8px 10px;border-radius:10px;cursor:pointer;color:var(--ink);font-size:13px;font-weight:500;transition:background .15s,transform .15s}
.nav-item:hover,.nav-item.active{background:var(--blue-soft);color:var(--blue)}
.nav-icon{font-size:15px;width:22px;text-align:center}
.sidebar-footer{padding:8px 4px 4px}
.help-card{background:linear-gradient(135deg,var(--blue-soft),var(--yellow-soft));border:1px solid var(--border);border-radius:12px;padding:12px}
.help-card-title{font-size:12px;font-weight:700;margin-bottom:4px}
.help-card-link{font-size:12px;color:var(--blue);font-weight:600}

#shared-flyout{
  position:fixed;z-index:500;min-width:200px;max-width:260px;
  background:var(--surface);border:1px solid var(--border);border-radius:12px;
  box-shadow:var(--shadow-hover);padding:8px;opacity:0;pointer-events:none;
  transform:translateX(-4px);transition:opacity .15s,transform .15s;
}
#shared-flyout.show{opacity:1;pointer-events:all;transform:none}
.nav-flyout-hdr{font-size:11px;font-weight:700;color:var(--muted);padding:6px 8px 8px;border-bottom:1px solid var(--border);margin-bottom:4px}
.nav-flyout-item{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:8px;border-radius:8px;font-size:12px;font-weight:500;transition:background .15s}
.nav-flyout-item:hover{background:var(--blue-soft);color:var(--blue)}
.nav-flyout-arrow{opacity:.4;font-size:11px}
.nav-flyout-empty{font-size:12px;color:var(--muted);padding:10px 8px}

/* MAIN */
.main-area{margin-left:var(--sidebar-w);flex:1;min-width:0}
.topbar{
  height:56px;display:flex;align-items:center;gap:12px;padding:0 16px;
  background:rgba(255,255,255,.75);border-bottom:1px solid var(--border);
  backdrop-filter:blur(12px);position:sticky;top:0;z-index:200;
}
.burger-mobile{display:none;font-size:20px;padding:6px;color:var(--ink)}
.search-box{flex:1;max-width:420px;display:flex;align-items:center;gap:8px;background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:8px 12px;box-shadow:var(--shadow)}
.search-box input{flex:1;border:none;outline:none;font-size:13px;background:transparent;color:var(--ink)}
.search-kbd{font-size:10px;color:var(--muted);background:var(--blue-soft);border-radius:6px;padding:2px 6px;font-weight:600}
.topbar-right{display:flex;align-items:center;gap:10px;margin-left:auto}
.tb-bell{position:relative;font-size:16px;padding:6px}
.tb-bell-badge{position:absolute;top:2px;right:2px;background:var(--coral);color:#fff;font-size:9px;font-weight:700;border-radius:8px;min-width:14px;height:14px;display:grid;place-items:center}
.tb-weather{display:flex;align-items:center;gap:4px;font-size:12px;font-weight:600;background:var(--yellow-soft);border:1px solid rgba(245,197,24,.35);border-radius:10px;padding:5px 10px}
.tb-clock{text-align:right;line-height:1.2}
.tb-time{font-size:14px;font-weight:700;font-variant-numeric:tabular-nums}
.tb-date{font-size:10px;color:var(--muted)}
.tb-profile{display:flex;align-items:center;gap:8px}
.tb-avatar{width:32px;height:32px;border-radius:10px;background:linear-gradient(135deg,var(--blue),#60a5fa);color:#fff;display:grid;place-items:center;font-size:11px;font-weight:800}
.tb-name{font-size:12px;font-weight:600}.tb-name .sub{display:block;font-size:10px;color:var(--muted);font-weight:500}

main{padding:14px 16px 28px;display:flex;flex-direction:column;gap:14px}

.card-lift{transition:transform .18s ease,box-shadow .18s ease}
.card-lift:hover{transform:translateY(-3px);box-shadow:var(--shadow-hover)}

.top-row{display:grid;grid-template-columns:1.6fr 1fr;gap:12px}
.banner{
  min-height:160px;border-radius:var(--radius);padding:18px 20px;
  background:linear-gradient(135deg,#dbeafe 0%,#eff6ff 45%,#fff8db 100%);
  border:1px solid var(--border);box-shadow:var(--shadow);position:relative;overflow:hidden;
}
.banner:before{content:"";position:absolute;right:-30px;top:-40px;width:160px;height:160px;border-radius:50%;background:rgba(47,128,237,.12)}
.banner:after{content:"";position:absolute;right:40px;bottom:-50px;width:120px;height:120px;border-radius:50%;background:rgba(245,197,24,.2)}
.banner-left{position:relative;z-index:1;max-width:92%}
.banner-eyebrow{display:inline-block;font-size:11px;font-weight:700;color:var(--blue);background:rgba(255,255,255,.7);border:1px solid var(--border);border-radius:8px;padding:3px 8px;margin-bottom:8px}
.banner-news-main{font-size:16px;font-weight:700;line-height:1.45;margin-bottom:12px;min-height:2.9em}
.banner-news-main a{color:var(--ink)}.banner-news-main a:hover{color:var(--blue)}
.banner-dajare{display:flex;align-items:flex-start;gap:8px;font-size:12px;color:var(--muted);background:rgba(255,255,255,.65);border-radius:10px;padding:8px 10px;border:1px solid rgba(255,255,255,.8)}
.banner-dajare-badge{flex-shrink:0;background:var(--yellow);color:var(--ink);font-size:10px;font-weight:800;border-radius:6px;padding:2px 6px}

.quick-panel{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:12px;box-shadow:var(--shadow)}
.quick-title{font-size:12px;font-weight:800;letter-spacing:.04em;color:var(--muted);margin-bottom:10px;text-transform:uppercase}
.quick-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.quick-card{position:relative;display:flex;flex-direction:column;align-items:center;gap:6px;padding:12px 8px;border-radius:12px;border:1px solid var(--border);background:#fafcff;transition:transform .18s,box-shadow .18s}
.quick-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-hover)}
.quick-edit-btn{position:absolute;top:4px;right:4px;font-size:10px;opacity:.45;padding:2px}
.quick-edit-btn:hover{opacity:1}
.quick-icon{width:36px;height:36px;border-radius:10px;display:grid;place-items:center;font-size:18px}
.quick-name{font-size:11px;font-weight:600;text-align:center;line-height:1.3}

.mid-row{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:12px}
.find-browse-card,.announce-card,.todo-card{
  background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);
  padding:14px;box-shadow:var(--shadow);transition:transform .18s,box-shadow .18s;
}
.find-browse-card:hover,.announce-card:hover,.todo-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-hover)}
.find-hdr,.announce-hdr,.todo-hdr,.browse-hdr{font-size:14px;font-weight:800}
.find-input-row{position:relative;display:flex;gap:6px;margin-top:10px}
.find-input{flex:1;border:1px solid var(--border);border-radius:10px;padding:8px 10px;font-size:13px;outline:none;background:#f8fbff}
.find-input:focus{border-color:var(--blue);box-shadow:0 0 0 3px var(--blue-soft)}
.find-btn{background:var(--blue);color:#fff;border-radius:10px;padding:8px 14px;font-size:12px;font-weight:700}
.popular-row{font-size:11px;color:var(--muted);display:flex;flex-wrap:wrap;align-items:center;gap:6px;margin-top:8px}
.popular-chip{background:var(--blue-soft);color:var(--blue);border-radius:999px;padding:3px 8px;font-weight:600;cursor:pointer;border:1px solid transparent}
.popular-chip:hover{border-color:rgba(47,128,237,.25)}
.browse-hdr-row{display:flex;align-items:center;justify-content:space-between;margin-top:14px}
.view-all{font-size:11px;color:var(--blue);font-weight:700;cursor:pointer}
.cat-browse-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}
.cat-browse-card{text-align:center;padding:10px 4px;border-radius:12px;border:1px solid var(--border);background:#fafcff;cursor:pointer;transition:transform .15s,box-shadow .15s}
.cat-browse-card:hover{transform:translateY(-2px);box-shadow:var(--shadow)}
.cat-browse-icon{width:32px;height:32px;border-radius:9px;display:grid;place-items:center;margin:0 auto 6px;font-size:15px}
.cat-browse-name{font-size:10px;font-weight:700;line-height:1.3}
.cat-browse-count{font-size:9px;color:var(--muted);margin-top:2px}

.search-results-panel{display:none;position:absolute;left:0;right:48px;top:calc(100% + 4px);background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow-hover);max-height:280px;overflow-y:auto;z-index:50;padding:6px}
.search-results-panel.open{display:block}
.sr-item{display:flex;align-items:center;gap:8px;padding:8px;border-radius:8px;font-size:12px}
.sr-item:hover{background:var(--blue-soft)}
.sr-cat-badge{font-size:9px;font-weight:700;border-radius:6px;padding:2px 6px;flex-shrink:0}
.sr-name{flex:1;font-weight:600}
.sr-empty{padding:12px;font-size:12px;color:var(--muted)}

.announce-item{padding:10px 0;border-bottom:1px solid var(--border)}
.announce-item:last-child{border-bottom:none;padding-bottom:0}
.announce-tag{font-size:9px;font-weight:800;border-radius:6px;padding:2px 6px;text-transform:uppercase}
.tag-system{background:var(--blue-soft);color:var(--blue)}
.tag-update{background:var(--yellow-soft);color:#a16207}
.tag-notice{background:#ffe4e6;color:var(--coral)}
.announce-date{font-size:10px;color:var(--muted);margin-left:4px}
.announce-title{font-size:13px;font-weight:700;margin-top:4px}
.announce-desc{font-size:11px;color:var(--muted);margin-top:2px}

.todo-hdr-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
.todo-add-row{display:flex;gap:6px;margin-bottom:10px}
.todo-add-row input{flex:1;border:1px solid var(--border);border-radius:10px;padding:7px 10px;font-size:12px;outline:none;background:#f8fbff}
.todo-add-row input:focus{border-color:var(--blue);box-shadow:0 0 0 3px var(--blue-soft)}
.todo-add-btn{background:var(--blue);color:#fff;border-radius:10px;padding:7px 12px;font-size:12px;font-weight:700}
.todo-list{display:flex;flex-direction:column;gap:6px;max-height:220px;overflow-y:auto}
.todo-item{display:flex;align-items:center;gap:8px;padding:8px;border-radius:10px;border:1px solid var(--border);background:#fafcff}
.todo-item.done .todo-text{text-decoration:line-through;color:var(--muted)}
.todo-check{width:18px;height:18px;border-radius:6px;border:1.5px solid var(--blue);display:grid;place-items:center;flex-shrink:0;cursor:pointer;font-size:11px;color:transparent;background:#fff}
.todo-item.done .todo-check{background:var(--green);border-color:var(--green);color:#fff}
.todo-text{flex:1;font-size:12px;font-weight:500;word-break:break-word}
.todo-del{font-size:11px;color:var(--muted);padding:2px 4px;cursor:pointer}
.todo-del:hover{color:var(--coral)}
.todo-empty{font-size:12px;color:var(--muted);padding:8px 0}

.all-cat-title{font-size:15px;font-weight:800}
.featured-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}
.ft-slot{display:flex;align-items:center;gap:10px;padding:10px;border-radius:12px;border:1px solid var(--border);background:var(--surface);box-shadow:var(--shadow);transition:transform .18s,box-shadow .18s}
.ft-slot.filled:hover{transform:translateY(-3px);box-shadow:var(--shadow-hover)}
.ft-slot-thumb{width:40px;height:40px;border-radius:10px;display:grid;place-items:center;font-size:18px;flex-shrink:0}
.ft-slot-name{font-size:12px;font-weight:700}
.ft-slot-badge{font-size:10px;color:var(--muted)}

.shortcut-bar{display:flex;flex-wrap:wrap;align-items:center;gap:8px;padding:12px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow)}
.shortcut-label{font-size:12px;font-weight:800;margin-right:4px}
.shortcut-item{display:inline-flex;align-items:center;gap:6px;padding:7px 10px;border-radius:10px;border:1px solid var(--border);background:#fafcff;font-size:12px;font-weight:600;transition:transform .15s,box-shadow .15s}
.shortcut-item:hover{transform:translateY(-2px);box-shadow:var(--shadow)}
.shortcut-item .ic{font-size:14px}
.shortcut-item .sub{font-size:10px;color:var(--muted);font-weight:500;margin-left:4px}
.shortcut-rm{font-size:10px;color:var(--muted);margin-left:4px}
.shortcut-add{color:var(--blue);border-style:dashed;cursor:pointer}

.cat-modal-overlay,.modal-overlay{position:fixed;inset:0;z-index:600;background:rgba(30,41,59,.4);display:none;align-items:center;justify-content:center;padding:16px;backdrop-filter:blur(3px)}
.cat-modal-overlay.open,.modal-overlay.open{display:flex}
.cat-modal-box,.modal-box{background:var(--surface);border:1px solid var(--border);border-radius:16px;box-shadow:var(--shadow-hover);width:min(480px,100%);max-height:min(80vh,640px);overflow:hidden;display:flex;flex-direction:column}
.cat-modal-hdr{display:flex;align-items:center;gap:12px;padding:14px 16px;border-bottom:1px solid var(--border)}
.cat-modal-icon{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;font-size:18px}
.cat-modal-name{font-size:15px;font-weight:800}
.cat-modal-sub{font-size:11px;color:var(--muted)}
.cat-modal-close{margin-left:auto;cursor:pointer;color:var(--muted);padding:4px}
.cat-modal-body{padding:10px 12px;overflow-y:auto}
.cat-modal-lk{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px;border-radius:10px;border:1px solid transparent}
.cat-modal-lk:hover{background:var(--blue-soft);border-color:var(--border)}
.cat-modal-lk-name{font-size:13px;font-weight:700}
.cat-modal-lk-dom{font-size:10px;color:var(--muted)}
.cat-modal-lk-arrow{color:var(--muted)}
.modal-title{font-size:15px;font-weight:800;padding:16px 16px 8px}
.modal-field{padding:6px 16px}
.modal-label{display:block;font-size:11px;font-weight:700;color:var(--muted);margin-bottom:4px}
.modal-input{width:100%;border:1px solid var(--border);border-radius:10px;padding:9px 11px;font-size:13px;outline:none;background:#f8fbff}
.modal-input:focus{border-color:var(--blue);box-shadow:0 0 0 3px var(--blue-soft)}
.modal-actions{display:flex;justify-content:flex-end;gap:8px;padding:12px 16px 16px}
.modal-btn{border-radius:10px;padding:8px 14px;font-size:12px;font-weight:700}
.modal-btn.outline{border:1px solid var(--border);color:var(--muted)}
.modal-btn.primary{background:var(--blue);color:#fff}
.add-pick-item{display:flex;align-items:center;gap:10px;width:100%;text-align:left;padding:10px;border-radius:10px;border:1px solid var(--border);background:#fafcff}
.add-pick-item:hover{background:var(--blue-soft)}
.add-pick-icon{width:32px;height:32px;border-radius:9px;display:grid;place-items:center;flex-shrink:0}
.add-pick-name{font-size:12px;font-weight:700}
.add-pick-dom,.add-pick-count{font-size:10px;color:var(--muted)}
.add-pick-count{margin-left:auto}

@media(max-width:1100px){
  .mid-row{grid-template-columns:1fr 1fr}
  .todo-card{grid-column:1/-1}
  .featured-grid{grid-template-columns:repeat(3,1fr)}
  .cat-browse-grid{grid-template-columns:repeat(3,1fr)}
}
@media(max-width:860px){
  .sidebar{transform:translateX(-105%);transition:transform .25s}
  .sidebar.open{transform:none}
  .sidebar-close{display:block}
  .main-area{margin-left:0}
  .burger-mobile{display:block}
  .top-row{grid-template-columns:1fr}
  .mid-row{grid-template-columns:1fr}
  .tb-name,.tb-bell{display:none}
  .featured-grid{grid-template-columns:1fr 1fr}
  .search-box{max-width:none}
}
</style>
</head>
<body>
<div class="lock" id="lock-screen">
  <div class="lock-stripe ls1"></div><div class="lock-stripe ls2"></div>
  <div class="lock-stripe ls3"></div><div class="lock-stripe ls4"></div>
  <div class="lock-stripe ls5"></div><div class="lock-stripe ls6"></div>
  <div class="lock-inner">
    <div class="lock-logo-txt">
      <span class="fill">MISHIMA</span>
      <span class="outline">PORT<em>AL.</em></span>
    </div>
    <div class="lock-form">
      <div class="lock-label">// Password Required</div>
      <div class="lock-input-wrap">
        <input id="lock-input" type="password" placeholder="Enter password..." autocomplete="off"/>
        <button class="lock-btn" id="lock-btn">Enter ↗</button>
      </div>
      <div class="lock-error" id="lock-error">⚠ Incorrect password</div>
    </div>
  </div>
</div>

<div class="overlay" id="overlay"></div>

<div class="app">
  <nav class="sidebar" id="sidebar">
    <div class="sidebar-logo">
      <div class="logo-icon"></div>
      <div class="logo-text">MISHIMA<span class="sub">PORTAL</span></div>
      <div class="sidebar-close" id="sidebar-close">✕</div>
    </div>
    <div class="sidebar-nav">
      <div class="nav-item active" onclick="scrollToTop()"><span class="nav-icon">🏠</span><span class="nav-text">ホーム</span></div>
      <div class="nav-label"><span class="nav-text">カテゴリ</span></div>
      <div id="sidebar-cat-list"></div>
    </div>
    <div class="sidebar-footer">
      <div class="help-card">
        <div class="help-card-title">🎧 お困りですか？</div>
        <a class="help-card-link" href="#">鈴木まで</a>
      </div>
    </div>
  </nav>

  <div class="main-area">
    <div class="topbar">
      <div class="burger-mobile" id="burger-mobile">☰</div>
      <div class="search-box">
        <span>🔍</span>
        <input type="text" id="global-search" placeholder="人・資料・ツールなどを検索..." autocomplete="off">
        <span class="search-kbd">⌘K</span>
      </div>
      <div class="topbar-right">
        <div class="tb-bell">🔔<span class="tb-bell-badge">3</span></div>
        <div class="tb-weather"><span id="tb-icon">☀️</span><span id="tb-temp">--°C</span></div>
        <div class="tb-clock"><div class="tb-time" id="tb-time">--:--</div><div class="tb-date" id="tb-date">----.--.--</div></div>
        <div class="tb-profile">
          <div class="tb-avatar">MP</div>
          <div class="tb-name">Mishima Portal<span class="sub">プロフィール</span></div>
        </div>
      </div>
    </div>

    <main>
      <div class="top-row">
        <div class="banner card-lift">
          <div class="banner-left">
            <div class="banner-eyebrow">🤖 最新ニュース</div>
            <div class="banner-news-main" id="banner-news-text">ニュースを読み込み中...</div>
            <div class="banner-dajare"><span class="banner-dajare-badge">今日の豆知識</span><span id="banner-dajare-text"></span></div>
          </div>
        </div>
        <div class="quick-panel card-lift">
          <div class="quick-title">Quick Access</div>
          <div class="quick-grid" id="quick-grid"></div>
        </div>
      </div>

      <div class="mid-row">
        <div class="find-browse-card">
          <div>
            <div class="find-hdr">🔍 探しものを見つける</div>
            <div class="find-input-row">
              <input class="find-input" type="text" id="find-search" placeholder="リンク・資料・ツールなどを検索..." autocomplete="off">
              <button class="find-btn" onclick="doFind()">検索</button>
              <div class="search-results-panel" id="search-results-panel"></div>
            </div>
            <div class="popular-row">
              人気:
              <span class="popular-chip" onclick="quickSearch('静岡Branch')">静岡Branch</span>
              <span class="popular-chip" onclick="quickSearch('日次報告')">日次報告</span>
              <span class="popular-chip" onclick="quickSearch('シフト')">シフト</span>
              <span class="popular-chip" onclick="quickSearch('Meet')">Google Meet</span>
            </div>
          </div>
          <div>
            <div class="browse-hdr-row"><div class="browse-hdr">カテゴリから探す</div><span class="view-all" onclick="openAllCategoryPicker()">すべて見る</span></div>
            <div class="cat-browse-grid" id="browse-grid"></div>
          </div>
        </div>

        <div class="announce-card">
          <div class="announce-hdr-row">
            <div class="announce-hdr">📣 お知らせ</div>
          </div>
          <div id="announce-list"></div>
        </div>

        <div class="todo-card">
          <div class="todo-hdr-row">
            <div class="todo-hdr">✅ ToDo</div>
          </div>
          <div class="todo-add-row">
            <input type="text" id="todo-input" placeholder="やることを追加..." autocomplete="off" maxlength="120">
            <button class="todo-add-btn" id="todo-add-btn" type="button">追加</button>
          </div>
          <div class="todo-list" id="todo-list"></div>
        </div>
      </div>

      <div>
        <div class="browse-hdr-row"><div class="all-cat-title">よく使うツール</div></div>
        <div class="featured-grid" id="featured-grid"></div>
      </div>

      <div class="shortcut-bar" id="shortcut-bar">
        <div class="shortcut-label">⭐ マイショートカット</div>
        <div id="shortcut-items" style="display:contents"></div>
        <div class="shortcut-item shortcut-add" onclick="openAddModal()">＋ 追加する</div>
      </div>
    </main>
  </div>
</div>

<div class="cat-modal-overlay" id="cat-modal-overlay" onclick="if(event.target===this)closeCategoryModal()">
  <div class="cat-modal-box">
    <div class="cat-modal-hdr">
      <div class="cat-modal-icon" id="cat-modal-icon"></div>
      <div>
        <div class="cat-modal-name" id="cat-modal-name"></div>
        <div class="cat-modal-sub" id="cat-modal-sub"></div>
      </div>
      <div class="cat-modal-close" onclick="closeCategoryModal()">✕</div>
    </div>
    <div class="cat-modal-body" id="cat-modal-body"></div>
  </div>
</div>

<div class="modal-overlay" id="modal-overlay" onclick="if(event.target===this)closeAddModal()">
  <div class="modal-box" style="width:min(420px,100%)">
    <div class="modal-title" id="add-modal-title">ショートカットを追加</div>
    <div id="add-step1" style="padding:0 16px">
      <div class="modal-label" style="margin-bottom:10px">カテゴリを選んでください</div>
      <div id="add-cat-list" style="display:flex;flex-direction:column;gap:6px;max-height:340px;overflow-y:auto"></div>
    </div>
    <div id="add-step2" style="display:none;padding:0 16px">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px">
        <span style="cursor:pointer;color:var(--muted);font-size:13px" onclick="showAddStep1()">← 戻る</span>
        <span class="modal-label" style="margin-bottom:0" id="add-step2-title"></span>
      </div>
      <div id="add-link-list" style="display:flex;flex-direction:column;gap:6px;max-height:340px;overflow-y:auto"></div>
    </div>
    <div class="modal-actions">
      <button class="modal-btn outline" onclick="closeAddModal()">キャンセル</button>
    </div>
  </div>
</div>

<div class="modal-overlay" id="qa-modal-overlay" onclick="if(event.target===this)closeQaModal()">
  <div class="modal-box">
    <div class="modal-title">Quick Access を編集</div>
    <div class="modal-field">
      <label class="modal-label">タイトル</label>
      <input class="modal-input" id="qa-name" placeholder="例：会社ドライブ"/>
    </div>
    <div class="modal-field">
      <label class="modal-label">URL</label>
      <input class="modal-input" id="qa-url" placeholder="https://..."/>
    </div>
    <div class="modal-field">
      <label class="modal-label">アイコン（絵文字1つ）</label>
      <input class="modal-input" id="qa-icon" placeholder="📌" maxlength="2"/>
    </div>
    <div class="modal-actions">
      <button class="modal-btn outline" onclick="closeQaModal()">キャンセル</button>
      <button class="modal-btn primary" onclick="saveQaCard()">保存する</button>
    </div>
  </div>
</div>
